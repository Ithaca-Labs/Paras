# Copy to .env for local dev (docker compose reads it too).
DATABASE_URL=postgres://paras:paras@localhost:5432/paras
LOG_LEVEL=info

API_PORT=3000

# Auth (apps/api). AUTH_SECRET (>=32 chars) is required in production.
# AUTH_SECRET=
AUTH_DOMAIN=localhost:3000
AUTH_CHAIN_IDS=143,10143
# EMAIL_PROVIDER=console prints sign-in codes to the api log; resend needs RESEND_API_KEY.
EMAIL_PROVIDER=console
# RESEND_API_KEY=
# EMAIL_FROM=Paras <login@your-domain>
WORKER_PORT=3001
MCP_PORT=3002
EXECUTOR_PORT=3003

# apps/mcp talks to the API through the typed client
API_URL=http://localhost:3000

# Fixture harness (tests only): set to 1 to record real Venue responses. Never in CI.
# RECORD_FIXTURES=1
