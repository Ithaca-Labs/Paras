# Copy to .env for local dev (docker compose reads it too).
DATABASE_URL=postgres://paras:paras@localhost:5432/paras
LOG_LEVEL=info

API_PORT=3000
WORKER_PORT=3001
MCP_PORT=3002
EXECUTOR_PORT=3003

# apps/mcp talks to the API through the typed client
API_URL=http://localhost:3000

