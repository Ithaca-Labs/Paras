# Copy to .env for local dev (docker compose reads it too).
DATABASE_URL=postgres://paras:paras@localhost:5432/paras
LOG_LEVEL=info

API_PORT=3000

# Auth (apps/api). AUTH_SECRET (>=32 chars) is required in production.
# AUTH_SECRET=
AUTH_DOMAIN=localhost:3000
AUTH_CHAIN_IDS=143,10143
# EMAIL_PROVIDER=console prints sign-in codes to the api log; resend needs RESEND_API_KEY.
EMAIL_PROVIDER=console
# RESEND_API_KEY=
# EMAIL_FROM=Paras <login@your-domain>

# Magic Links. WEB_BASE_URL builds shareable URLs. MAGIC_LINK_KEYS = kid:secret[,kid2:secret2]
# (secret >= 32 chars, required in production). Rotate: add a key, set MAGIC_LINK_ACTIVE_KID, drop old after TTL.
WEB_BASE_URL=http://localhost:5173
# MAGIC_LINK_KEYS=k1:replace-with-32+-char-secret-value-000
# MAGIC_LINK_ACTIVE_KID=k1
# MAGIC_LINK_TTL_SECONDS=3600
# MAGIC_LINK_MAX_TTL_SECONDS=86400
WORKER_PORT=3001
MCP_PORT=3002
EXECUTOR_PORT=3003

# apps/mcp talks to the API through the typed client
API_URL=http://localhost:3000

# Fixture harness (tests only): set to 1 to record real Venue responses. Never in CI.
# RECORD_FIXTURES=1

# Executor (apps/executor). Mainnet requires EXECUTOR_KEY_BACKEND=kms (stub).
# EXECUTOR_NETWORK=testnet
# EXECUTOR_KEY_BACKEND=env
# EXECUTOR_MASTER_KEY=   # 32 bytes hex
# POLYGON_RPC_URL=
# POLYMARKET_BUILDER_API_KEY=
# POLYMARKET_BUILDER_SECRET=
# POLYMARKET_BUILDER_PASSPHRASE=
# Local only: POLYGON_FORK_RPC_URL=https://polygon-bor-rpc.publicnode.com enables the anvil fork test.
# Sentence model for semantic search + tagging (api, worker). `off` = full-text only / no tagging.
# EMBEDDING_MODEL=Xenova/all-MiniLM-L6-v2
# EMBEDDING_CACHE_DIR=/tmp/paras-models
# Long-tail Venues (api, worker). Polymarket US, Opinion, Myriad, Probable and Novig need no key.
# Key-gated Venues are off while unset; see docs/BLOCKERS.md, "Venue API keys".
# PREDICTFUN_API_KEY=
# PREDICTFUN_API_URL=https://api.predict.fun
# PROPHETX_API_KEY=
# PROPHETX_API_URL=https://cash.api.prophetx.co/partner
# Optional: raises Myriad's rate limit (30 req/10 s -> 200 req/s).
# MYRIAD_API_KEY=
