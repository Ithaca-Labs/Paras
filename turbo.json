{
  "$schema": "https://turbo.build/schema.json",
  "agentGuidance": false,
  "globalPassThroughEnv": [
    "DATABASE_URL",
    "RECORD_FIXTURES",
    "CI",
    "DOCKER_HOST",
    "TESTCONTAINERS_RYUK_DISABLED",
    "TESTCONTAINERS_HOST_OVERRIDE"
  ],
  "tasks": {
    "build": {
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"],
      "env": ["API_URL", "NEXT_PUBLIC_PRIVY_APP_ID", "PRIVY_APP_ID"]
    },
    "typecheck": {},
    "test": { "cache": false }
  }
}
